# tree-dev: the mess. Rigs, results, the lisp twin, charts.
# The learner is tree.py (run it with pypy3); the lua/yue line
# is in attic/. The shippable repo is ../tree; see: make package
# Long payloads live at the end as comment blocks #<name> ... ;
# make greps its own source to build them (see mark). Inside a
# block, {Tmp} and {Here} are filled in by sed at extraction time.
SHELL := bash
.SILENT:

Tmp  ?= $(HOME)/tmp/tree-dev
Here := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))

help: ## show this help
	grep -E '^[a-z.%/]+:.*##' Makefile | sed 's/:.*## /\t/'

msg ?= saving

push: ## git add this dir, commit (msg="..."), push
	git add . && { git commit -m "$(msg)" || true; } && git push

run: ## 5x2 classification over the 39 sets (pypy3) -> a dat
	pypy3 gen.py

docs: ## render tree.py + tree_eg.py 3-col into ../tree/docs
	mkdir -p $(HOME)/gh/tree/docs
	python3 hi.py 3 tree.py tree_eg.py > $(HOME)/gh/tree/docs/index.html

html: docs ## render the docs, then open them in the browser
	open $(HOME)/gh/tree/docs/index.html

package: docs ## copy the learner into ../tree
	cp tree.py $(HOME)/gh/tree/
	cd $(HOME)/gh/tree && \
	  echo "tree.py  $$(shasum -a1 tree.py | cut -c1-12)  $$(wc -l < tree.py) lines" && \
	  git status --short
	echo "now: cd ~/gh/tree && git commit -am ... && git push"

Paper := $(HOME)/gh/jssclose
Reg   := MOOTREG=$(HOME)/gits/moot

allfigs: ## the two overview figures: whole corpus, one axis, no groups
	python3 -B allplot.py cls $(Paper)/ens-all-cls.png \
	  runs/nose39-yue.txt runs/se61-yue.txt
	python3 -B allplot.py reg $(Paper)/ens-all-reg.png \
	  runs/reg56.csv runs/sereg.csv

Active := runs/active.txt runs/active-knn.txt runs/active-tabicl.txt \
          runs/active-secs-tree.txt runs/active-secs-heavy.txt

actfig: ## the optimizer figure, in the same layout as Figs 2 and 3
	python3 -B allplot.py act $(Paper)/ens-active.png $(Active)

pricetex: ## the price-per-point table
	python3 -B price.py > $(Paper)/price.tex
	echo "wrote $(Paper)/price.tex"

sesoitex: ## the SESOI sweep table: what survives a rising floor
	python3 -B sesoi.py > $(Paper)/sesoi.tex
	echo "wrote $(Paper)/sesoi.tex"

acttex: ## the optimizer study's variance table, for the back of the paper
	python3 -B actvar.py runs/active.txt runs/active-knn.txt \
	  runs/active-tabicl.txt > $(Paper)/actvar.tex
	echo "wrote $(Paper)/actvar.tex"

ablfig: ## the acquisition ablation: smart acquire vs random select
	python3 -B allplot.py abl $(Paper)/ens-active-abl.png $(Active)

regfigs: ## redraw the two regression figures into the paper
	$(Reg)/regression python3 -B regplot2.py runs/reg56.csv \
	  $(Paper)/ens-tree-reg-noxse.png
	$(Reg)/optimize   python3 -B regplot2.py runs/sereg.csv \
	  $(Paper)/ens-tree-reg-se.png

regtex: ## regenerate the paper's regression section from runs/
	python3 -B regsection.py runs/reg56.csv runs/sereg.csv \
	  $(Paper)/regfigs.tex > $(Paper)/regression.tex
	echo "wrote $(Paper)/regression.tex and regfigs.tex"

clstex: ## regenerate the paper's classification variance table
	python3 -B clsvar.py runs/nose39-yue.txt runs/se61-yue.txt \
	  > $(Paper)/clsvar.tex
	echo "wrote $(Paper)/clsvar.tex"

fig1: ## regenerate the paper's opening figure (LOC + the two runtimes)
	python3 -B fig1.py $(Paper)/loccounts.tex > $(Paper)/fig1.tex
	echo "wrote $(Paper)/fig1.tex"

reg: regfigs allfigs actfig ablfig regtex pricetex fig1 ## every generated number in the paper, recomputed

sh: $(Tmp)/bashrc $(Tmp)/nvim.lua ## bash with our prompt; vi = clean nvim
	bash --rcfile $(Tmp)/bashrc -i

$(Tmp):
	mkdir -p $(Tmp)/undo $(Tmp)/swap $(Tmp)/backup

#-- config files: comment blocks below, extracted by mark ----------
H    := \#
mark  = gawk -v RS= 'index($$0,"$(H)<$(1)>")==1' $(Here)/Makefile | tail -n +2 \
        | sed -e 's/^$(H) \{0,1\}//' -e 's|{Tmp}|$(Tmp)|g' -e 's|{Here}|$(Here)|g'

$(Tmp)/nvim.lua: $(Here)/Makefile | $(Tmp) ; $(call mark,nvim.lua) > $@
$(Tmp)/bashrc:   $(Here)/Makefile | $(Tmp) ; $(call mark,bashrc)   > $@

