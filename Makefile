# balsa-dev: the mess. Rigs, results, the lisp twin, charts.
# The shippable rock lives next door in ../balsa; see: make package
# Long payloads live at the end as comment blocks #<name> ... ;
# make greps its own source to build them (see mark). Inside a
# block, {Tmp} and {Here} are filled in by sed at extraction time.
SHELL := bash
.SILENT:

Tmp  ?= $(HOME)/tmp/balsa-dev
Here := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))

help: ## show this help
	grep -E '^[a-z.%/]+:.*##' Makefile | sed 's/:.*## /\t/'

msg ?= saving

push: ## git add this dir, commit (msg="..."), push
	git add . && { git commit -m "$(msg)" || true; } && git push

run: ## run every eg (sbcl --script bald.lisp all)
	sbcl --script bald.lisp all

yue: ## rebuild balsa.lua + balsa_eg.lua (5.1-safe: no goto)
	yue -c -s --target=5.1 balsa.yue && yue -c -s --target=5.1 balsa_eg.yue

docs: ## render balsa.yue + balsa_eg.yue 3-col into ../balsa/docs
	mkdir -p $(HOME)/gh/balsa/docs
	python3 hi.py 3 balsa.yue balsa_eg.yue > $(HOME)/gh/balsa/docs/index.html

package: yue docs ## copy learner into ../balsa, rebuild its .lua there
	cp balsa.yue $(HOME)/gh/balsa/
	cd $(HOME)/gh/balsa && yue -c -s --target=5.1 balsa.yue && \
	  echo "balsa.lua  $$(shasum -a1 balsa.lua | cut -c1-12)  $$(wc -l < balsa.lua) lines" && \
	  git status --short
	echo "now: cd ~/gh/balsa && git commit -am ... && git push"

charts: ## redraw bald.png, bald30.png from runs/ (no data files needed)
	python3 -B plot.py bald.png "lightgbm(100 trees)=lgbm.txt:lgbm" \
	  "hair(10 trees, 8 bins)=lgbm.txt:q8" "bald(10 trees, 8 bins)=n10q8.dat:1"
	python3 -B plot.py bald30.png --tabicl "lightgbm(100 trees)=lgbm.txt:lgbm" \
	  "bald(10 trees, 8 bins)=n10q8.dat:1" "bald(30 trees, 16 bins)=grid-q16.dat:0"

Paper := $(HOME)/gh/jssprimer
Reg   := MOOTREG=$(HOME)/gits/moot

regfigs: ## redraw the two regression figures into the paper
	$(Reg)/regression python3 -B regplot2.py runs/reg56.csv \
	  $(Paper)/ens-balsa-reg-noxse.png
	$(Reg)/optimize   python3 -B regplot2.py runs/sereg.csv \
	  $(Paper)/ens-balsa-reg-se.png

regtex: ## regenerate the paper's regression section from runs/
	python3 -B regsection.py runs/reg56.csv runs/sereg.csv \
	  > $(Paper)/regression.tex
	echo "wrote $(Paper)/regression.tex"

clstex: ## regenerate the paper's classification variance table
	python3 -B clsvar.py runs/nose39-yue.txt runs/se61-yue.txt \
	  > $(Paper)/clsvar.tex
	echo "wrote $(Paper)/clsvar.tex"

reg: regfigs regtex clstex ## every generated number in the paper, recomputed

sh: $(Tmp)/bashrc $(Tmp)/nvim.lua ## bash with our prompt; vi = clean nvim
	bash --rcfile $(Tmp)/bashrc -i

$(Tmp):
	mkdir -p $(Tmp)/undo $(Tmp)/swap $(Tmp)/backup

#-- config files: comment blocks below, extracted by mark ----------
H    := \#
mark  = gawk -v RS= 'index($$0,"$(H)<$(1)>")==1' $(Here)/Makefile | tail -n +2 \
        | sed -e 's/^$(H) \{0,1\}//' -e 's|{Tmp}|$(Tmp)|g' -e 's|{Here}|$(Here)|g'

$(Tmp)/nvim.lua: $(Here)/Makefile | $(Tmp) ; $(call mark,nvim.lua) > $@
$(Tmp)/bashrc:   $(Here)/Makefile | $(Tmp) ; $(call mark,bashrc)   > $@

