-- balsa_eg.yue: the dialog. Experiments, stats and printing;
-- balsa.yue is the model it talks to.
-- usage: yue -c -s *.yue, then
--   luajit balsa_eg.lua [data...]        5x2 xval, 30 trees, 16 bins
--   luajit balsa_eg.lua --replay F.dat   rerun F's recorded folds
-- (c) 2026 Tim Menzies <timm@ieee.org>, MIT license
import floor, sqrt, max, min from math
b = require "balsa"
import the, srand, shuffle, bisect, csv, Tbl, Col, adds, div,
       disty, forest, votes, predict, aucs from b
fmt = string.format


-------------------------------------------------------------- stats
median = (xs) ->
  ys = [x for x in *xs]
  table.sort ys
  ys[1 + floor #ys / 2]

cliffs = (xs, ys) ->                    -- xs, ys sorted
  d = 0
  for x in *xs
    d += bisect(ys, x) - (#ys - bisect ys, x, true)
  math.abs(d) / (#xs * #ys)

ks = (xs, ys) ->                        -- units of the .05 critical
  n, m, d = #xs, #ys, 0
  for v in *{xs, ys}
    for x in *v
      d = max d, math.abs(bisect(xs, x, true) / n -
                          bisect(ys, x, true) / m)
  d / sqrt((n + m) / (n * m))

-- Three questions, and they have to be different ones.  prudence asks if
-- the gap is big enough to bother reporting, in the units we report.
-- cliffs asks about order, ks about shape.  Cohen's d used to sit here too
-- and was dropped: gap over pooled sd is a second opinion on what cliffs
-- already counts, and the part only it supplied -- a floor in raw units --
-- is what prudence now says outright.
same = (xs, ys, prudence=the.prudence) ->
  xs = [x for x in *xs]
  ys = [y for y in *ys]
  table.sort xs
  table.sort ys
  if math.abs(adds(xs).mu - adds(ys).mu) < prudence
    return true                         -- too small to care about
  cliffs(xs, ys) <= 0.195 and ks(xs, ys) <= 1.36

rank = (d) ->                           -- {{name, nums}...} -> ranks
  table.sort d, (x, y) -> median(x[2]) < median(y[2])
  r, pool, out = 1, nil, {}
  for kv in *d
    if pool and not same pool, kv[2] then r, pool = r + 1, nil
    pool = pool or {}
    pool[] = x for x in *kv[2]
    out[kv[1]] = r
  out

--------------------------------------------------------------- rigs
xval = (rows, fn, m=5, n=2) ->
  for _ = 1, m
    u = shuffle rows
    for kf = 0, n - 1
      train, test = {}, {}
      for i, row in ipairs u
        if (i - 1) % n == kf then test[] = row else train[] = row
      fn train, test

ens = (sets) ->
  print "#n30 "
  for f in *sets
    tb = Tbl csv "~/gits/moot/classify/#{f}.csv"
    at = tb.cols.klass.at
    kl = (row) -> row.labels[at]
    xval tb.rows, (train, test) ->
      t0 = os.clock!
      a = aucs votes forest(tb, train, kl), test, kl
      io.write fmt "%s|%.3f |%.3f |\n", f, a, os.clock! - t0
      io.flush!

replay = (dat) ->                       -- rerun DAT's recorded folds:
  print "#1:q16 n30 "                   -- 1 tree all-cols, 30 rf
  tb, v, name = nil, nil, nil
  for line in io.lines dat
    if line\match "^#" then continue
    f = line\match "^([^|]*)|"
    ids = line\match "|([^|]*)$"
    if f != name
      name = f
      tb = Tbl csv "~/gits/moot/classify/#{f}.csv"
      v = {}                            -- id = 0-based csv row #
      for i, row in ipairs tb.rows
        v[#tb.rows - i] = row
    at = tb.cols.klass.at
    kl = (row) -> row.labels[at]
    test, inh = {}, {}
    for s in ids\gmatch "%d+"
      row = v[tonumber(s)]
      test[] = row
      inh[row] = true
    train = [row for row in *tb.rows when not inh[row]]
    aucs_, secs = {}, {}
    for treat in *{{1, false}, {30, true}}
      the.trees, the.rf = treat[1], treat[2]
      t0 = os.clock!
      aucs_[] = aucs votes forest(tb, train, kl), test, kl
      secs[] = os.clock! - t0
    io.write fmt "%s|%.3f %.3f |%.3f %.3f |%s\n",
                 f, aucs_[1], aucs_[2], secs[1], secs[2], ids
    io.flush!

mae = (want, got) ->                    -- mean |want - got|
  s, n = 0, 0
  for i, w in ipairs want
    s += math.abs w - got[i]
    n += 1
  s / max n, 1

reg = (sets) ->                         -- 5x2 over the regression
  print "#1:reg n30:reg mean "          -- corpus: MAE of 1 tree, 30
  for f in *sets                        -- trees, and guess-the-mean
    tb = Tbl csv "#{os.getenv("MOOTREG") or "~/gits/moot/regression"}/#{f}.csv"
    g = tb.cols.klass
    if not g                            -- else the first goal in
      for col in *tb.cols.y             -- file order
        if not g or col.at < g.at then g = col
    y = (row) -> row[g.at]
    ids = {}
    for i, row in ipairs tb.rows
      ids[row] = #tb.rows - i           -- 0-based csv row #
    xval tb.rows, (train, test) ->
      want, keep = {}, {}
      for row in *test
        w = y row
        if w != "?"
          want[] = w
          keep[] = row
      mu = 0
      m = 0
      for row in *train
        w = y row
        if w != "?"
          mu += w
          m += 1
      mu /= max m, 1
      maes, secs = {}, {}
      for arm in *{{1, false}, {30, true}}
        the.trees, the.rf = arm[1], arm[2]
        t0 = os.clock!
        trees = forest tb, train, y, Col
        maes[] = mae want, [predict trees, row for row in *keep]
        secs[] = os.clock! - t0
      maes[] = mae want, [mu for _ in *keep]
      io.write fmt "%s|%.4g %.4g %.4g |%.3f %.3f |%s 
",
        f, maes[1], maes[2], maes[3], secs[1], secs[2],
        table.concat [tostring ids[row] for row in *test], " "
      io.flush!

opt = (sets) ->                         -- optimize: fit on train,
  print "#1:opt n30:opt rand "          -- sort test by predicted
  for f in *sets                        -- d2h, label the best 5,
    tb = Tbl csv "#{os.getenv("MOOTOPT") or "~/gits/moot/optimize"}/#{f}.csv"
    for row in *tb.rows                 -- d2h: paid once, per row
      row.d2h = disty tb, row
    y = (row) -> row.d2h
    all = adds [row.d2h for row in *tb.rows]      -- the WHOLE table
    lo = math.huge                      -- scores are relative to it
    for row in *tb.rows
      lo = min lo, row.d2h
    score = (got) -> 100 * (1 - (got - lo) / (all.mu - lo + 1e-32))
    best5 = (rows) ->                   -- label 5, keep the winner
      b = math.huge
      for i = 1, min 5, #rows
        b = min b, rows[i].d2h
      b
    ids = {}
    for i, row in ipairs tb.rows
      ids[row] = #tb.rows - i           -- 0-based csv row #
    xval tb.rows, (train, test) ->
      scores, secs = {}, {}
      for arm in *{{1, false}, {30, true}}
        the.trees, the.rf = arm[1], arm[2]
        t0 = os.clock!
        trees = forest tb, train, y, Col
        guess = [{row, predict trees, row} for row in *test]
        table.sort guess, (a, b) -> a[2] < b[2]
        scores[] = score best5 [g[1] for g in *guess]
        secs[] = os.clock! - t0
      scores[] = score best5 shuffle test            -- label 5 at random
      io.write fmt "%s|%.2f %.2f %.2f |%.3f %.3f |%s \n",
        f, scores[1], scores[2], scores[3], secs[1], secs[2],
        table.concat [tostring ids[row] for row in *test], " "
      io.flush!

REG = {"2dplanes", "abalone", "ailerons", "auto93", "autohorse",
  "autompg", "autoprice", "bank32nh", "bank8FM", "baskball",
  "bodyfat", "bolts", "breasttumor", "cal.housing", "cholesterol",
  "cleveland", "cloud", "cpu.act", "cpu", "cpu.small",
  "detroit", "diabetes.numeric", "echomonths",
  "elevators", "elusage", "fishcatch", "fried", "fruitfly",
  "gascons", "house16H", "house8L", "housing", "hungarian",
  "kin8nm", "longley", "lowbwt", "machine.cpu", "mbagrade", "meta",
  "mv", "pbc", "pharynx", "pol", "pollution", "puma32H", "puma8NH",
  "pwlinear", "pyrim", "quake", "schlvote", "sensory", "servo",
  "sleep", "stock", "strike", "triazines", "veteran", "vineyard",
  "wisconsin"}

ENS = {"balance.scale", "blood-transfusion-service-center",
  "breast.w", "diabetes", "ecoli", "glass", "ionosphere", "sonar",
  "vehicle", "wdbc", "vote", "soybean", "tic-tac-toe", "german",
  "car", "solar.flare2", "primary.tumor", "breast.cancer",
  "spect.test", "audiology", "credit.a", "eucalyptus", "ilpd",
  "heart.c", "hepatitis", "colic", "autos", "cylinder.bands",
  "credit.g", "cmc", "hypothyroid", "sick",
  "Internet-Advertisements", "churn", "COMPAS53", "nomao",
  "bank-marketing", "electricity", "adult"}

srand the.seed
if arg[1] == "--replay"
  replay arg[2]
elseif arg[1] == "--opt"
  table.remove arg, 1
  opt arg
elseif arg[1] == "--reg"
  table.remove arg, 1
  reg #arg > 0 and arg or REG
else
  ens #arg > 0 and arg or ENS
