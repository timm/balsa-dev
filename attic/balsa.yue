-- balsa.yue: the learner, a Yue port of bald (lisp). Data, bins,
-- trees, forest, auc. Same Park-Miller rand, so same shuffles.
-- The library: no printing, no files beyond csv, no experiments.
-- The rigs (5x2 xval, fold replay, stats) live in balsa_eg.yue.
-- Names say shape: tb col row; v = one cell value, b = a bin #,
-- n = a count, s = a string; fn mk = functions; plurals are lists;
-- sym1, sym2 where only Syms will do; y reads a row's label.
-- Everything counted is a small int LABEL, assigned at load, ONE
-- convention: known values get 1..n (x cells bin #s 1..nbins,
-- class cells 1..nk; each col's legend in its .labels); unknown ?
-- is -1, everywhere. So hot loops walk arrays 1..n and never
-- pairs(), whose order is the version's hash seed, not ours:
-- same seed, same model, on any Lua.
-- (c) 2026 Tim Menzies <timm@ieee.org>, MIT license
import floor, sqrt, max, min, log from math
LOG2 = log 2

the = {seed: 1234567891, prudence: 0.01, bins: 16,
       trees: 30, cap: 200, leaf: 2, maxd: 30, rf: true}

------------------------------------------------------------- random
seed = the.seed
srand = (n) -> seed = n
rand = (n=1) ->
  seed = (16807 * seed) % 2147483647
  n * seed / 2147483647

shuffle = (rows) ->                     -- new, shuffled copy
  u = [row for row in *rows]
  for i = #u, 2, -1
    j = 1 + floor rand i
    u[i], u[j] = u[j], u[i]
  u

pick = (n, m) ->                        -- 0..n-1; or just m DISTINCT
  if not (m and m < n)
    return [i for i = 0, n - 1]
  got, out = {}, {}
  while #out < m
    i = floor rand n
    if not got[i]
      got[i] = true
      out[] = i
  table.sort out
  out

---------------------------------------------------------------- csv
thing = (cell) ->
  cell = cell\match "^%s*(.-)%s*$"
  tonumber(cell) or cell

csv = (file) ->
  file = file\gsub "^~", os.getenv "HOME"
  rows = {}
  for line in io.lines file
    txt = line\gsub("\r", "")\match "^%s*(.-)%s*$"
    if txt != ""
      rows[] = [thing cell for cell in "#{txt},"\gmatch "(.-),"]
  rows

--------------------------------------------------------------- data
-- Header: Uppercase = Num, else Sym. Last char: ! class, X skip.
-- "?" cells unknown. A row IS its csv cells (numeric indexes),
-- plus one named field: labels, its label per x column.
Col = (txt="N", at=0) ->                -- no args: an anonymous Num
  if txt\match "^%u"
    {:at, :txt, isnum: true, n: 0, mu: 0, m2: 0,  -- a Num; goal:
     goal: txt\match("%-$") and 0 or 1}          -- 0=min, 1=max
  else
    {:at, :txt, n: 0, has: {}}                 -- a Sym

add = (col, v, inc=1) ->
  if v == "?"
    return
  col.n += inc
  if col.isnum
    d = v - col.mu
    col.mu += inc * d / col.n
    col.m2 = max 0, col.m2 + inc * d * (v - col.mu)
  else
    col.has[v] = (col.has[v] or 0) + inc

adds = (vs, col=Col!) ->
  add col, v for v in *vs
  col

div = (col) ->                          -- sd for Nums, entropy for Syms
  if col.isnum
    return if col.n < 2 then 0 else sqrt(col.m2 / (col.n - 1))
  e = 0
  e -= m/col.n * log(m/col.n) for _, m in pairs col.has when m > 0
  e / LOG2

-- class counts: an array indexed by label 1..nk
Ys = (nk) -> {:nk, n: 0, has: [0 for _ = 1, nk]}

yadd = (ys, v) ->
  if ys.nk                              -- labels: count into the array
    if v > 0                            -- v = -1: class unknown
      ys.has[v] += 1
      ys.n += 1
  else
    add ys, v                           -- a Num: Welford; skips ?

yadds = (vs, ys) ->
  yadd ys, v for v in *vs
  ys

yclear = (ys) ->                        -- a pooled scratch, as new
  if ys.nk
    for i = 1, ys.nk
      ys.has[i] = 0
    ys.n = 0
  else
    ys.n, ys.mu, ys.m2 = 0, 0, 0
  ys

yfold = (ys1, ys2, inc=1, out=ys1) ->   -- out = 1 + inc*2; out
  if ys1.nk                             -- defaults to 1: fold in place
    for i = 1, ys1.nk
      out.has[i] = ys1.has[i] + inc * ys2.has[i]
    out.n = ys1.n + inc * ys2.n
  else                                  -- Nums: Chan et al.'s closed
    m = ys2.n                           -- form adds or (inc=-1)
    n = ys1.n + inc * m                 -- subtracts two (n, mu, m2)
    if n <= 0
      out.n, out.mu, out.m2 = 0, 0, 0
    else
      mu = ys1.mu + inc * m * (ys2.mu - ys1.mu) / n
      d  = ys2.mu - (if n < ys1.n then mu else ys1.mu)
      out.m2 = max 0, ys1.m2 + inc * (ys2.m2 +
                 min(n, ys1.n) * m * d * d / max(n, ys1.n))
      out.mu, out.n = mu, n
  out

ydiv = (ys) ->                          -- entropy of the counts
  if ys.n < 2
    return 0
  e = 0
  e -= c * log(c) for c in *ys.has when c > 0
  (e / ys.n + log ys.n) / LOG2

norm = (num, v) ->                      -- v -> 0..1, logistic z-score
  z = (v - num.mu) / (div(num) + 1e-32)
  z = max -3, min 3, z
  1 / (1 + math.exp -1.7 * z)

disty = (tb, row) ->                    -- distance to heaven, 0=best:
  d, n = 0, 0                           -- euclidean over the goals
  for col in *tb.cols.y
    v = row[col.at]
    if v != "?"
      d += (norm(col, v) - col.goal) ^ 2
      n += 1
  (d / max n, 1) ^ 0.5

mid = (ys) ->                           -- center: majority label | mu
  if not ys.nk
    return ys.mu
  best, most = nil, -1
  for i = 1, ys.nk
    if ys.has[i] > most
      best, most = i, ys.has[i]
  best

spread = (ys) ->                        -- entropy | sd, for xpect
  if ys.nk then ydiv ys else div ys

Cols = (names) ->
  all = [Col txt, at for at, txt in ipairs names]
  x, y, klass = {}, {}, nil
  for i = #all, 1, -1                   -- reversed: the lisp pushes
    col = all[i]
    e = col.txt\sub -1
    if col.txt\match "X$" then continue
    if e == "+" or e == "-" or e == "!"
      y[] = col
      if e == "!" then klass = col
    else
      x[] = col
  {:names, :all, :x, :y, :klass}

------------- labels: made once at load; trees cut on label #s
bisect = (vs, v, le) ->                 -- #items in sorted vs below v
  lo, hi = 1, #vs + 1
  while lo < hi
    mp = floor (lo + hi) / 2
    below = if le then vs[mp] <= v else vs[mp] < v
    if below then lo = mp + 1 else hi = mp
  lo - 1

mklabels = (col, rows, n) ->
  if col.isnum                             -- n bins, equal #known in each
    vs = [row[col.at] for row in *rows when row[col.at] != "?"]
    table.sort vs
    out, b4 = {}, nil
    for j = 0, (#vs > 0 and n - 1 or -1)
      v = vs[1 + floor j * #vs / n]
      if v != b4
        out[] = v
        b4 = v
    out
  else                                  -- the n-1 commonest values
    vs = [{v, m} for v, m in pairs col.has]
    table.sort vs, (a, b) ->
      a[2] > b[2] or (a[2] == b[2] and tostring(a[1]) < tostring(b[1]))
    [vs[i][1] for i = 1, min n - 1, #vs]

tolabel = (col, v) ->                   -- v -> its label 1..; ? = -1
  if v == "?" then return -1
  if col.isnum then return max 1, bisect(col.labels, v, true)
  for i, u in ipairs col.labels
    if u == v then return i
  #col.labels + 1                       -- rare sym values pool here

labelall = (tb) ->                      -- once per tbl: a legend per
  kl = tb.cols.klass                    -- col; a Sym klass keeps
  if kl and kl.isnum then kl = nil      -- EVERY value (a Num klass
  cols = [col for col in *tb.cols.x]    -- is a regression goal: no
  if kl then cols[] = kl                -- labels), then every cell's
  for col in *cols                      -- label, onto the row
    n = if col == kl then 1/0 else the.bins
    col.labels = mklabels col, tb.rows, n
  for row in *tb.rows
    row.labels = {}
    row.labels[col.at] = tolabel col, row[col.at] for col in *cols
  tb.nk = if kl then #kl.labels else 0

Tbl = (rows) ->
  tb = {cols: Cols(rows[1]), rows: {}}
  for i = #rows, 2, -1                  -- newest first, like the lisp
    row = rows[i]
    tb.rows[] = row
    add col, row[col.at] for col in *tb.cols.all
  labelall tb
  tb

--------------------------------------------------------------- tree
argmost = (better) ->                   -- visitor; f! = best so far
  out, b4 = nil, nil
  (x, n) ->
    if x and (b4 == nil or better n, b4) then out, b4 = x, n
    out, b4

xpect = (a, b) ->                       -- size-weighted spread
  (a.n * spread(a) + b.n * spread(b)) / (a.n + b.n + 1e-32)

cuts = (col, rows, ys, mk, leaf, best, pool) ->
  nb = #col.labels
  bins = [yclear pool[b] for b = 1, nb + 1]  -- sym "rare" at nb+1;
  for i, row in ipairs rows             -- all scratch is pooled: the
    b = row.labels[col.at]              -- constructor was 1/5th of
    if b > 0 then yadd bins[b], ys[i]   -- this file's runtime, as gc
  yes  = yclear pool[nb + 2]
  no   = yclear pool[nb + 3]            -- nums: the sliding right side
  rest = yclear pool[nb + 4]            -- syms: scratch per value
  yfold no, bin for bin in *bins
  for b = 1, nb
    bin = bins[b]
    local lhs, rhs
    if col.isnum
      yfold yes, bin                    -- slide: yes grows,
      yfold no, bin, -1                 -- no shrinks, no undo
      lhs, rhs = yes, no                -- bins <= b, vs bins > b
    else
      lhs, rhs = bin, yfold(no, bin, -1, rest)  -- value, vs others
    if leaf <= min lhs.n, rhs.n
      best {col, b}, xpect lhs, rhs

best_cut = (xcols, rows, ys, mk, m, leaf, pool) ->
  best = argmost (a, b) -> a < b
  for i in *pick #xcols, m
    cuts xcols[i + 1], rows, ys, mk, leaf, best, pool
  best!

yes_ = (col, b, row) ->                 -- row on the yes side of cut?
  w = row.labels[col.at]
  w < 0 or (if col.isnum then w <= b else w == b)

tree = (rows, y, xcols, mk, m, leaf, maxd, lvl=0, pool) ->
  pool = pool or [mk! for _ = 1, the.bins + 4]
  ys = [y row for row in *rows]
  cut = lvl < maxd and best_cut xcols, rows, ys, mk, m, leaf, pool
  node = {ys: yadds(ys, mk!), n: #rows}
  if cut
    col, b = cut[1], cut[2]
    node.v = b
    node.ati, node.isnum = col.at, col.isnum
    yes = [row for row in *rows when yes_ col, b, row]
    no  = [row for row in *rows when not yes_ col, b, row]
    node.yes = tree yes, y, xcols, mk, m, leaf, maxd, lvl + 1, pool
    node.no  = tree no,  y, xcols, mk, m, leaf, maxd, lvl + 1, pool
  node

leaf_of = (node, row) ->                -- flat fields: no col deref
  while node.ati
    w = row.labels[node.ati]
    ok = w < 0 or (if node.isnum then w <= node.v else w == node.v)
    node = ok and node.yes or node.no
  node

------------------------------------------------------------- forest
capped = (rows, y, n, nk) ->            -- <= n random rows per class
  if not nk                             -- (regression: n rows, any)
    u = shuffle rows
    return [u[i] for i = 1, min n, #u]
  h, out = {}, {}
  for row in *shuffle rows
    v = y row
    h[v] = (h[v] or 0) + 1
    if h[v] <= n then out[] = row
  out

forest = (tb, rows, y, mk) ->           -- mk: the y summary; default
  xcols = tb.cols.x                     -- klass counts (nil mk + a
  mk = mk or -> Ys tb.nk                -- custom y = regression:
  nk = mk!.nk                           -- pass mk = Col)
  m = nil                               -- cols per cut: Breiman says
  if the.rf                             -- sqrt(p) for classification
    m = if nk then math.ceil sqrt #xcols else math.ceil #xcols / 3
  --                                       but p/3 for regression
  if the.cap
    rows = capped rows, y, the.cap, nk
  half = ->
    u = shuffle rows
    [u[i] for i = 1, floor #rows / 2]
  out = {}
  for _ = 1, the.trees
    out[] = tree the.trees == 1 and rows or half!, y, xcols, mk, m,
                 the.leaf, the.maxd
  out

vote = (trees, row) ->                  -- label -> mean leaf share
  nk = trees[1].ys.nk
  h, w = [0 for _ = 1, nk], #trees
  for node in *trees
    ys = leaf_of(node, row).ys
    for i = 1, nk
      h[i] += ys.has[i] / ys.n / w
  h

votes = (trees, rows, y) ->
  [{y(row), vote trees, row} for row in *rows]

predict = (trees, row) ->               -- regression: mean leaf mid
  s = 0
  for node in *trees
    s += mid leaf_of(node, row).ys
  s / #trees

---------------------------------------------------------------- auc
auc = (pos, neg) ->                     -- Mann-Whitney, ties halved:
  if #pos == 0 or #neg == 0             -- the chance a random pos
    return nil                          -- outscores a random neg
  table.sort neg
  s = 0
  for p in *pos
    s += (bisect(neg, p) + bisect(neg, p, true)) / 2
  s / (#pos * #neg)

aucs = (wps) ->                         -- expected 1-vs-rest, 0..100
  n, sum = 0, 0
  for c = 1, #wps[1][2]                 -- 1..nk
    pos = [wp[2][c] for wp in *wps when wp[1] == c]
    neg = [wp[2][c] for wp in *wps when wp[1] != c]
    a = auc pos, neg
    if a
      n += #pos
      sum += #pos * a
  100 * sum / max n, 1

-- the module: what balsa_eg.yue (and any other rig) may touch
{:the, :srand, :rand, :shuffle, :bisect, :csv, :Tbl, :Col, :adds,
 :div, :mid, :disty, :tree, :leaf_of, :forest, :votes, :predict,
 :auc, :aucs}
